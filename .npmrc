# Keep `npm install` quiet for people building PearDrop from source.
# The only remaining warnings are "deprecated" notices for glob@7, inflight and
# rimraf@2, pulled in by electron-builder's packaging internals (@electron/asar,
# electron-winstaller → temp). They only run when building installers, never
# ship, and can't be overridden without breaking packaging. `npm audit` is clean.
# Errors still print. Run `npm install --loglevel=warn` to see warnings again.
loglevel=error
fund=false
