{
  "name": "peardrop",
  "productName": "PearDrop",
  "version": "0.29.0",
  "description": "Simple, elegant P2P file sharing",
  "license": "MIT",
  "author": "Anjou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peardrive/peardrop-desktop.git"
  },
  "main": "out/main/index.js",
  "type": "commonjs",
  "bin": {
    "peardrop": "./bin/peardrop"
  },
  "scripts": {
    "app": "electron-vite preview",
    "dev": "cross-env PEARDROP_BOOTSTRAP=127.0.0.1:8787 PEARDROP_PROFILE=dev electron-vite dev",
    "dev:peer": "cross-env PEARDROP_BOOTSTRAP=127.0.0.1:8787 PEARDROP_PROFILE=dev-peer electron-vite dev",
    "bootstrap": "node scripts/bootstrapper.mjs",
    "boostrap": "npm run bootstrap --",
    "postinstall": "node scripts/ensure-electron.cjs",
    "setup:electron": "node scripts/ensure-electron.cjs",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --config electron-builder.config.cjs --win",
    "build:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac",
    "build:linux": "npm run build && electron-builder --config electron-builder.config.cjs --linux",
    "build:all": "npm run build && electron-builder --config electron-builder.config.cjs --win --mac --linux",
    "build:dir": "npm run build && electron-builder --config electron-builder.config.cjs --dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run test:engine && npm run test:unit",
    "test:engine": "node --test \"test/**/*.test.js\"",
    "test:unit": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "bs58": "^6.0.0",
    "corestore": "^7.5.0",
    "hyperdht": "^6.30.0",
    "hyperdrive": "^13.3.0",
    "hyperswarm": "^4.16.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.21.5": true
  }
}
